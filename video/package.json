{
  "name": "fruya-video-pub",
  "private": true,
  "description": "Vidéo publicitaire Fruya (motion design, Remotion). Séparée de l'app.",
  "scripts": {
    "studio": "remotion studio",
    "musique": "node scripts/musique.mjs",
    "sons": "node scripts/sons.mjs",
    "rendu": "node scripts/musique.mjs && node scripts/sons.mjs && remotion render Pub sortie/fruya-pub-9x16.mp4",
    "flyer": "remotion still Flyer sortie/fruya-flyer-a5.png --image-format=png",
    "apercu": "remotion still Pub sortie/apercu.png --frame=420"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.535",
    "@remotion/google-fonts": "^4.0.535",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.535"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
